# ========================================================
# Telegram Bot Configuration
# ========================================================

# 1. Token for the client-facing bot (obtained from @BotFather)
CLIENT_BOT_TOKEN=YOUR_CLIENT_BOT_TOKEN_HERE

# 2. Token for the worker/psychologist-facing bot (obtained from @BotFather)
WORKER_BOT_TOKEN=YOUR_WORKER_BOT_TOKEN_HERE

# 3. Target chat ID where worker bot delivers incoming client messages.
#    This can be:
#    - A Telegram Group / Channel ID (e.g., -1001234567890)
#    - A personal Telegram user ID (e.g., 123456789)
#    (Leave empty or 0 if workers register individually by sending /start to worker_bot)
WORKER_CHAT_ID=0

# 4. Optional secret authorization password for workers who send /start to worker_bot directly.
#    Example: /start secret123
WORKER_SECRET_KEY=psychology_worker_secret_2026

# 5. Database path (defaults to local SQLite database in project directory)
# ========================================================
# PostgreSQL Database Configuration
# ========================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=psychology_bot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/psychology_bot

# Fallback SQLite path (used if DATABASE_URL is not set or when running standalone without Docker)
DATABASE_PATH=data/bot.db


# ========================================================
# Telegram Bot Configuration
# ========================================================

# 1. Token for the client-facing bot (obtained from @BotFather)
CLIENT_BOT_TOKEN=YOUR_CLIENT_BOT_TOKEN_HERE

# 2. Token for the worker/psychologist-facing bot (obtained from @BotFather)
WORKER_BOT_TOKEN=YOUR_WORKER_BOT_TOKEN_HERE

# 3. Specialist / Admin Login & Password
#    Workers enter these in worker_bot to authorize and receive client messages
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin12345

# ========================================================
# PostgreSQL Database Configuration
# ========================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=psychology_bot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/psychology_bot

# Fallback SQLite path (used when running standalone without Docker)
DATABASE_PATH=data/bot.db
